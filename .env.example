# Optional local runtime configuration. npm start loads .env when present.
# Keep authorization codes and pairing tokens in the application UI, never in this file.
PORT=43110
CAMPUS_DB_PATH=data/runtime/campus-assistant.sqlite

# Optional: only for a first-time import into a new empty database.
# CAMPUS_LEGACY_DATA_PATH=/absolute/path/to/your-local-legacy-data.json
