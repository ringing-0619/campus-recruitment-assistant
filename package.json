{
  "name": "campus-recruitment-assistant",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch --env-file-if-exists=.env.development src/server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.server.json && vite build && npm run extension:check",
    "start": "node --env-file-if-exists=.env --enable-source-maps dist-server/server/index.js",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "extension:check": "node scripts/check-extension.mjs",
    "install:agent": "bash scripts/install-launch-agent.sh",
    "uninstall:agent": "bash scripts/uninstall-launch-agent.sh",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "repo:check": "node scripts/check-repository.mjs",
    "check": "npm run format:check && npm run typecheck && npm test && npm run extension:check && npm run repo:check",
    "smoke": "node scripts/smoke-test.mjs",
    "validate": "npm run check && npm run build && npm run smoke",
    "package:source": "node scripts/package-source.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.2.1",
    "imapflow": "^1.0.181",
    "mailparser": "^3.7.2"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.13.10",
    "concurrently": "^9.1.2",
    "prettier": "3.9.10",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2",
    "vite": "8.3.5",
    "vitest": "^5.0.1"
  },
  "description": "本地优先的校招投递管理工具，支持邮箱同步、招聘网站采集、目标统计与行动日历。",
  "license": "UNLICENSED",
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "keywords": [
    "recruitment",
    "job-tracker",
    "local-first",
    "imap",
    "browser-extension"
  ],
  "overrides": {
    "@fastify/static": {
      "glob": "^14.0.3"
    }
  }
}
